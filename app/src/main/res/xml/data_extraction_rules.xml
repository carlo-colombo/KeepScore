<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (targetSdk 31+) backup/transfer policy. The game database and
     preferences are included; the transient external backup files are not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
