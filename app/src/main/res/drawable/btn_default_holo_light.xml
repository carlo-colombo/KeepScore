<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy id, kept because helper/ColorScheme.java loads it by id for the scoring screen's
     +/- and delta buttons (ColorScheme.Light). It used to hold the Holo-light nine-patch
     buttons, which were unreadable on the black window background; the state list now
     delegates to the calculator button background so every button shares one definition. -->
