<?xml version="1.0" encoding="utf-8"?>
<!-- Calculator button background: one definition for every button in the app, including the
     scoring screen's +/- and delta buttons, which load @drawable/btn_default_holo_light by id
     from helper/ColorScheme.java (that legacy id now delegates here, see btn_default_holo_light.xml). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false" android:drawable="@drawable/calc_button_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/calc_button_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/calc_button_focused" />
    <item android:drawable="@drawable/calc_button_normal" />
</selector>
