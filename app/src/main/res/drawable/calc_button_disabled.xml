<?xml version="1.0" encoding="utf-8"?>
<!-- Calculator button, disabled state: flat surface so it recedes against the black background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/calc_surface" />
    <stroke android:width="1dp" android:color="@color/calc_border" />
    <corners android:radius="8dp" />
</shape>
